+// daytona-arcade-recomp oracle (M2TRACE_SNDLOG): every SCSP and bank access
+// by the sound 68000, tagged with the index of the instruction making it.
+namespace {
+u16 m2scsp_logr(offs_t a, u16 v) {
+	if(g_m2snd_log) fprintf(g_m2snd_log, "r %llu %06x %x\n", (unsigned long long)(g_m2snd_insn - 1), a, unsigned(v));
+	return v;
+}
+void m2scsp_logw(offs_t a, unsigned v, unsigned m) {
+	if(g_m2snd_log) fprintf(g_m2snd_log, "w %llu %06x %x %x\n", (unsigned long long)(g_m2snd_insn - 1), a, v, m);
+}
+}
