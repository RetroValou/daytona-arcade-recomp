+// M2TRACE_SNDPCS: every address the sound 68000 executed, written at exit
+// (seeds for m2sndrecomp: the targets of its indirect jumps).
+static std::set<u32> *g_m2snd_pcs = nullptr;
+static void m2snd_write_pcs()
+{
+	if(const char *path = getenv("M2TRACE_SNDPCS"); path && g_m2snd_pcs) {
+		if(FILE *f = fopen(path, "w")) {
+			for(u32 pc : *g_m2snd_pcs)
+				fprintf(f, "%06x\n", pc);
+			fclose(f);
+		}
+	}
+}
 
