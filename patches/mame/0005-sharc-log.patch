 // Coprocessor - SHARC
 
+// daytona-arcade-recomp: SHARC-side log for the static recompiler's oracle
+// (Model 2B). $M2TRACE_SHARCLOG gets one line per SHARC-visible event, in order:
+//   up N            the program upload ended (N 16-bit words), the SHARC boots
+//   in V            the SHARC popped V from the input FIFO
+//   ie              the SHARC read the input FIFO while it was empty (0)
+//   out V           the SHARC pushed V to the output FIFO
+//   br A V          the SHARC read buffer RAM (A = word offset & 0x7fff)
+//   bw A V          the SHARC wrote buffer RAM
+//   iop A V         the i960 wrote the SHARC's IOP register A (after boot too)
+static FILE *m2_sharc_log()
+{
+	static FILE *f = nullptr;
+	static bool tried = false;
+	if (!tried) {
+		tried = true;
+		if (const char *p = getenv("M2TRACE_SHARCLOG"))
+			f = fopen(p, "w");
+	}
+	return f;
+}
+
 u32 model2b_state::copro_sharc_buffer_r(offs_t offset)
 {
-	return m_bufferram[offset & 0x7fff];
+	const u32 v = m_bufferram[offset & 0x7fff];
+	if (!machine().side_effects_disabled())
+		if (FILE *f = m2_sharc_log()) fprintf(f, "br %x %x\n", offset & 0x7fff, v);
+	return v;
 }
 
 void model2b_state::copro_sharc_buffer_w(offs_t offset, u32 data)
 {
+	if (FILE *f = m2_sharc_log()) fprintf(f, "bw %x %x\n", offset & 0x7fff, data);
 	m_bufferram[offset & 0x7fff] = data;
 }
 
